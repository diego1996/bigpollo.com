# Configuración FTP para HostGator
# Copia este archivo como .env.deploy y completa con tus datos reales

# Datos FTP de HostGator
FTP_HOST=bigpollo.com.co
FTP_USER=tu_usuario_ftp@bigpollo.com.co
FTP_PASSWORD=tu_contraseña_ftp
FTP_PORT=21

# Configuración adicional (opcional)
# REMOTE_PATH=/public_html/
# LOCAL_PATH=./dist